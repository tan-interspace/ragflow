# =============================================================================
# RAGFlow Production Environment Configuration
# =============================================================================
# Copy this file to .env and customize the values for your production environment
# Make sure to change all default passwords and sensitive values!

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================

# RAGFlow Docker image to use
# Options: infiniflow/ragflow:v0.19.1-slim (2GB, no embedding models)
#          infiniflow/ragflow:v0.19.1 (9GB, with embedding models)
RAGFLOW_IMAGE=infiniflow/ragflow:v0.19.1

# Document engine type - determines which vector database to use
# Options: elasticsearch, infinity, opensearch
DOC_ENGINE=elasticsearch

# Docker Compose profiles to activate (based on DOC_ENGINE)
COMPOSE_PROFILES=elasticsearch

# Timezone for all services
TIMEZONE=UTC

# Main application HTTP port (external access)
SVR_HTTP_PORT=9380

# Application logging level
LOG_LEVEL=INFO

# User registration control (0=disabled, 1=enabled)
REGISTER_ENABLED=0

# Maximum file upload size in bytes (1GB default)
MAX_CONTENT_LENGTH=1073741824

# Document processing batch size
DOC_BULK_SIZE=4

# Embedding generation batch size
EMBEDDING_BATCH_SIZE=16

# =============================================================================
# EXTERNAL SERVICE ENDPOINTS
# =============================================================================

# Hugging Face endpoint (use mirror if needed)
# HF_ENDPOINT=https://hf-mirror.com
HF_ENDPOINT=https://huggingface.co

# OpenAI API configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Other LLM provider configurations
# AZURE_OPENAI_API_KEY=your_azure_openai_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# GOOGLE_API_KEY=your_google_api_key

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MySQL Database Settings
MYSQL_HOST=ragflow-mysql
MYSQL_PORT=5455
MYSQL_DBNAME=rag_flow
MYSQL_USER=ragflow
MYSQL_PASSWORD=CHANGE_THIS_MYSQL_PASSWORD_IN_PRODUCTION

# =============================================================================
# ELASTICSEARCH CONFIGURATION
# =============================================================================

# Elasticsearch version
STACK_VERSION=8.11.3

# Elasticsearch connection settings
ES_HOST=ragflow-elasticsearch
ES_PORT=1200
ELASTIC_PASSWORD=CHANGE_THIS_ELASTICSEARCH_PASSWORD_IN_PRODUCTION

# Elasticsearch memory limit (adjust based on available RAM)
ES_MEM_LIMIT=4G

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection settings
REDIS_HOST=ragflow-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_IN_PRODUCTION

# =============================================================================
# MINIO OBJECT STORAGE CONFIGURATION
# =============================================================================

# MinIO connection settings
MINIO_HOST=ragflow-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=ragflow_admin
MINIO_PASSWORD=CHANGE_THIS_MINIO_PASSWORD_IN_PRODUCTION

# =============================================================================
# ALTERNATIVE VECTOR DATABASES (Uncomment if using)
# =============================================================================

# OpenSearch Configuration (alternative to Elasticsearch)
# OS_HOST=ragflow-opensearch
# OS_PORT=1201
# OPENSEARCH_PASSWORD=CHANGE_THIS_OPENSEARCH_PASSWORD_IN_PRODUCTION

# Infinity Database Configuration (alternative vector DB)
# INFINITY_HOST=ragflow-infinity
# INFINITY_THRIFT_PORT=23817
# INFINITY_HTTP_PORT=23820
# INFINITY_PSQL_PORT=5432

# =============================================================================
# SANDBOX CONFIGURATION (Code Execution)
# =============================================================================

# Enable sandbox for code execution (uncomment to enable)
# SANDBOX_ENABLED=1
# SANDBOX_HOST=ragflow-sandbox-executor-manager
# SANDBOX_EXECUTOR_MANAGER_IMAGE=infiniflow/sandbox-executor-manager:latest
# SANDBOX_EXECUTOR_MANAGER_PORT=9385
# SANDBOX_EXECUTOR_MANAGER_POOL_SIZE=3
# SANDBOX_BASE_PYTHON_IMAGE=infiniflow/sandbox-base-python:latest
# SANDBOX_BASE_NODEJS_IMAGE=infiniflow/sandbox-base-nodejs:latest
# SANDBOX_ENABLE_SECCOMP=false
# SANDBOX_MAX_MEMORY=256m
# SANDBOX_TIMEOUT=10s

# To enable sandbox, also update COMPOSE_PROFILES:
# COMPOSE_PROFILES=elasticsearch,sandbox

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# Grafana admin password (if using monitoring stack)
GRAFANA_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD_IN_PRODUCTION

# Prometheus retention period
PROMETHEUS_RETENTION=30d

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# JWT secret for authentication (generate a strong random string)
JWT_SECRET=CHANGE_THIS_JWT_SECRET_TO_A_RANDOM_STRING_IN_PRODUCTION

# API rate limiting
API_RATE_LIMIT=1000

# CORS settings
CORS_ORIGINS=http://localhost:9380,https://your-domain.com

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

# SSL certificate paths (if using HTTPS)
# SSL_CERT_PATH=/path/to/your/certificate.crt
# SSL_KEY_PATH=/path/to/your/private.key
# SSL_CA_PATH=/path/to/your/ca-bundle.crt

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your-backup-access-key
BACKUP_S3_SECRET_KEY=your-backup-secret-key

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================

# Worker process configuration
WORKERS=4
MAX_CONNECTIONS=1000

# Memory limits for services (adjust based on available resources)
MEM_LIMIT=8073741824  # 8GB default

# Connection pool settings
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=30

# Cache settings
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# =============================================================================
# DEVELOPMENT/DEBUG SETTINGS (Disable in production)
# =============================================================================

# Debug mode (set to 0 in production)
DEBUG=0

# Enable debug ports (set to 0 in production)
ENABLE_DEBUG_PORTS=0

# MacOS optimizations (set to 1 if running on macOS)
MACOS=0

# =============================================================================
# CUSTOM STORAGE BACKENDS (Uncomment and configure if needed)
# =============================================================================

# Amazon S3 Configuration
# STORAGE_IMPL=S3
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_DEFAULT_REGION=us-east-1
# S3_BUCKET=your-ragflow-bucket
# S3_PREFIX_PATH=ragflow/

# Alibaba Cloud OSS Configuration
# STORAGE_IMPL=OSS
# ACCESS_KEY=your_oss_access_key
# SECRET_KEY=your_oss_secret_key
# ENDPOINT=http://oss-cn-hangzhou.aliyuncs.com
# REGION=cn-hangzhou
# BUCKET=your-ragflow-bucket
# OSS_PREFIX_PATH=ragflow/

# Azure Blob Storage Configuration
# STORAGE_IMPL=AZURE
# AZURE_STORAGE_ACCOUNT=your_storage_account
# AZURE_STORAGE_KEY=your_storage_key
# AZURE_CONTAINER_NAME=ragflow

# =============================================================================
# OAUTH/SSO CONFIGURATION (Uncomment and configure if needed)
# =============================================================================

# GitHub OAuth
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft Azure AD
# AZURE_CLIENT_ID=your_azure_client_id
# AZURE_CLIENT_SECRET=your_azure_client_secret
# AZURE_TENANT_ID=your_azure_tenant_id

# =============================================================================
# NOTES
# =============================================================================
# 1. Change all passwords and secrets before deploying to production
# 2. Use strong, randomly generated passwords
# 3. Consider using Docker secrets or external secret management
# 4. Regularly rotate passwords and API keys
# 5. Monitor resource usage and adjust limits accordingly
# 6. Enable SSL/TLS for production deployments
# 7. Set up proper backup and disaster recovery procedures
# 8. Configure monitoring and alerting
# 9. Review and update security settings regularly
# 10. Test the configuration in a staging environment first
