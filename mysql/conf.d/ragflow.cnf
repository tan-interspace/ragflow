# =============================================================================
# MySQL Production Configuration for RAGFlow
# =============================================================================
# This configuration provides production-ready settings for MySQL
# with performance, security, and reliability optimizations

[mysqld]
# Basic Settings
user = mysql
pid-file = /var/run/mysqld/mysqld.pid
socket = /var/run/mysqld/mysqld.sock
port = 3306
basedir = /usr
datadir = /var/lib/mysql
tmpdir = /tmp
lc-messages-dir = /usr/share/mysql
skip-external-locking

# Character Set and Collation
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init_connect = 'SET NAMES utf8mb4'

# SQL Mode
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_DATE,NO_ZERO_IN_DATE,ERROR_FOR_DIVISION_BY_ZERO

# Connection Settings
max_connections = 1000
max_connect_errors = 100000
max_user_connections = 950
back_log = 512
thread_cache_size = 100
thread_stack = 256K

# Authentication
default_authentication_plugin = mysql_native_password

# SSL/TLS Settings
tls_version = TLSv1.2,TLSv1.3
ssl_cipher = ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
require_secure_transport = OFF

# Buffer Pool and Memory Settings
innodb_buffer_pool_size = 2G
innodb_buffer_pool_instances = 8
innodb_buffer_pool_chunk_size = 128M
innodb_log_buffer_size = 64M
innodb_sort_buffer_size = 2M
read_buffer_size = 1M
read_rnd_buffer_size = 2M
sort_buffer_size = 2M
join_buffer_size = 2M
tmp_table_size = 256M
max_heap_table_size = 256M

# Query Cache (disabled in MySQL 8.0+)
# query_cache_type = 1
# query_cache_size = 256M
# query_cache_limit = 2M

# InnoDB Settings
innodb_file_per_table = 1
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_log_file_size = 512M
innodb_log_files_in_group = 2
innodb_undo_log_truncate = ON
innodb_undo_tablespaces = 3
innodb_undo_logs = 128

# InnoDB Performance
innodb_io_capacity = 2000
innodb_io_capacity_max = 4000
innodb_read_io_threads = 8
innodb_write_io_threads = 8
innodb_thread_concurrency = 0
innodb_purge_threads = 4
innodb_page_cleaners = 4

# InnoDB Locking
innodb_lock_wait_timeout = 120
innodb_deadlock_detect = ON
innodb_print_all_deadlocks = ON

# Binary Logging
log_bin = mysql-bin
binlog_format = ROW
binlog_row_image = FULL
expire_logs_days = 7
binlog_expire_logs_seconds = 604800
max_binlog_size = 1G
sync_binlog = 1

# Slow Query Log
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 2
log_queries_not_using_indexes = 1
log_slow_admin_statements = 1
log_slow_slave_statements = 1
min_examined_row_limit = 1000

# Error Log
log_error = /var/log/mysql/error.log
log_error_verbosity = 2

# General Log (disabled for performance)
general_log = 0
general_log_file = /var/log/mysql/general.log

# Performance Schema
performance_schema = ON
performance_schema_max_table_instances = 12500
performance_schema_max_table_handles = 4000

# Replication Settings (for master-slave setup)
server_id = 1
gtid_mode = ON
enforce_gtid_consistency = ON
log_slave_updates = ON
slave_preserve_commit_order = ON
slave_parallel_type = LOGICAL_CLOCK
slave_parallel_workers = 8

# Security Settings
local_infile = 0
secure_file_priv = /var/lib/mysql-files/
skip_show_database = 1

# Timeout Settings
interactive_timeout = 3600
wait_timeout = 3600
net_read_timeout = 60
net_write_timeout = 60
connect_timeout = 30

# Table Settings
table_open_cache = 4000
table_definition_cache = 2000
open_files_limit = 65535

# MyISAM Settings (if using MyISAM tables)
key_buffer_size = 128M
myisam_sort_buffer_size = 128M
myisam_max_sort_file_size = 2G
myisam_repair_threads = 1

# Network Settings
max_allowed_packet = 1G
net_buffer_length = 32K

# Optimizer Settings
optimizer_search_depth = 62
optimizer_prune_level = 1

# Group Replication (for MySQL Group Replication)
# plugin_load_add = 'group_replication.so'
# group_replication_group_name = "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
# group_replication_start_on_boot = off
# group_replication_local_address = "127.0.0.1:33061"
# group_replication_group_seeds = "127.0.0.1:33061"
# group_replication_bootstrap_group = off

[mysql]
default-character-set = utf8mb4

[mysqldump]
quick
quote-names
max_allowed_packet = 1G
default-character-set = utf8mb4

[mysql_safe]
log-error = /var/log/mysql/error.log
pid-file = /var/run/mysqld/mysqld.pid

[isamchk]
key_buffer_size = 256M
sort_buffer_size = 256M
read_buffer = 2M
write_buffer = 2M

[myisamchk]
key_buffer_size = 256M
sort_buffer_size = 256M
read_buffer = 2M
write_buffer = 2M

[mysqlhotcopy]
interactive-timeout

[client]
default-character-set = utf8mb4
port = 3306
socket = /var/run/mysqld/mysqld.sock
